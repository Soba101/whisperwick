# Copy this file to .env and edit it. .env is git-ignored.
LLM_BASE_URL=http://192.168.0.8:11434/v1
LLM_MODEL=qwen3.8:27b
# How many thinking calls to send to the model at once (default 1). Needs a server that allows it.
# WHISPERWICK_PARALLEL=4
# Which server runs the model: ollama (default) or llama-server (allows parallel calls).
# llama-server uses its own port, so change LLM_BASE_URL too:
# LLM_SERVER=llama-server
# LLM_BASE_URL=http://192.168.0.8:8080/v1
